<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>KPS.PetroUI.App</RootNamespace>
    <AssemblyName>KPS.PetroUI</AssemblyName>
    <ApplicationIcon></ApplicationIcon>
    <StartupObject>KPS.PetroUI.App.App</StartupObject>
    <UserSecretsId>kps-petroui-app-8b3e1d0f-4c2a-4a9e-9b5a-2f0e8d1c6b7d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DependentUpon>appsettings.json</DependentUpon>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="MahApps.Metro" Version="2.4.10" />
    <PackageReference Include="MaterialDesignThemes" Version="5.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KPS.PetroUI.Shell\KPS.PetroUI.Shell.csproj" />
    <ProjectReference Include="..\KPS.PetroUI.Core\KPS.PetroUI.Core.csproj" />
    <ProjectReference Include="..\KPS.PetroUI.Infrastructure\KPS.PetroUI.Infrastructure.csproj" />
    <ProjectReference Include="..\KPS.PetroUI.DAL\KPS.PetroUI.DAL.csproj" />
    <ProjectReference Include="..\KPS.PetroUI.Modules.Jobs\KPS.PetroUI.Modules.Jobs.csproj" />
    <ProjectReference Include="..\KPS.PetroUI.Modules.Reports\KPS.PetroUI.Modules.Reports.csproj" />
    <ProjectReference Include="..\KPS.PetroUI.Modules.Settings\KPS.PetroUI.Modules.Settings.csproj" />
  </ItemGroup>

</Project>
