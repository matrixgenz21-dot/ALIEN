<mah:MetroWindow x:Class="KPS.PetroUI.Shell.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
    xmlns:controls="clr-namespace:KPS.PetroUI.Shell.Controls"
    Title="KPS PetroUI"
    Width="1280"
    Height="800"
    WindowStartupLocation="CenterScreen"
    TitleCharacterCasing="Normal"
    BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
    BorderThickness="1">

    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <Button Content="{Binding CurrentUserName}" IsEnabled="False" />
            <Button Content="Sign Out" Command="{Binding LogoutCommand}" ToolTip="Sign out and return to the login screen"/>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:ToolbarControl Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <controls:SidebarControl Grid.Column="0" />

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource MaterialDesignDivider}" />

            <Grid Grid.Column="2">
                <avalonDock:DockingManager x:Name="DockManager"
                                           DocumentsSource="{Binding OpenDocuments}"
                                           ActiveContent="{Binding ActiveDocument, Mode=TwoWay}">
                    <avalonDock:DockingManager.DocumentHeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </avalonDock:DockingManager.DocumentHeaderTemplate>
                    <avalonDock:DockingManager.LayoutItemTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Content}" />
                        </DataTemplate>
                    </avalonDock:DockingManager.LayoutItemTemplate>
                    <avalonDock:LayoutRoot>
                        <avalonDock:LayoutPanel Orientation="Horizontal">
                            <avalonDock:LayoutDocumentPaneGroup>
                                <avalonDock:LayoutDocumentPane />
                            </avalonDock:LayoutDocumentPaneGroup>
                        </avalonDock:LayoutPanel>
                    </avalonDock:LayoutRoot>
                </avalonDock:DockingManager>

                <TextBlock Text="Select an item from the sidebar to begin."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.4"
                           FontSize="16"
                           Visibility="{Binding OpenDocuments.Count, Converter={StaticResource ZeroToVisibleConverter}, FallbackValue=Collapsed}" />
            </Grid>
        </Grid>

        <controls:StatusBarControl Grid.Row="2" />
    </Grid>
</mah:MetroWindow>
