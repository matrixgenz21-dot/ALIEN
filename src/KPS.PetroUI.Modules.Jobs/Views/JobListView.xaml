<UserControl x:Class="KPS.PetroUI.Modules.Jobs.Views.JobListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="Jobs"
                   FontSize="22"
                   FontWeight="Light"
                   Margin="0,0,0,12"/>
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Jobs}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Job #" Binding="{Binding JobNumber}" Width="120"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name}" Width="200"/>
                <DataGridTextColumn Header="Assigned To" Binding="{Binding AssignedEmployee.FullName}" Width="180"/>
                <DataGridTextColumn Header="Scheduled" Binding="{Binding ScheduledStart, StringFormat=yyyy-MM-dd}" Width="120"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
